/*
 * Cortex-M4 (CPU1) memory layout for the rticx-stm32h7 distribution.
 *
 * Generated by the distribution's `build.rs` for the `cm4` feature and handed
 * to `cortex-m-rt`'s `link.x` (which does `INCLUDE memory.x`).
 *
 * The Cortex-M4 cannot access the Cortex-M7 TCMs, so it runs from flash bank 2
 * and uses D2 SRAM1 through the Cortex-M4 alias (`0x1000_0000`). The IPC pool
 * lives in SRAM3, also through the Cortex-M4 alias (`0x1004_0000`), and is not
 * part of this `MEMORY` map.
 */
MEMORY
{
  FLASH : ORIGIN = 0x08100000, LENGTH = 1M
  RAM   : ORIGIN = 0x10000000, LENGTH = 128K
}

/* `h7-sram3` IPC pool, Cortex-M4 view (`0x1004_0000 + 0x1000`). Plain
 * assignments (not `PROVIDE`) so the absolute symbols are always emitted for
 * the `cargo xbin` ELF verifier (M6.9-T7). */
__rticx_xbin_pool_h7_sram3_start = 0x10041000;
__rticx_xbin_pool_h7_sram3_end   = 0x10042000;
