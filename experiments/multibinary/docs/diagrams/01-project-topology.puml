@startuml 01-project-topology
' Diagram 1 — Project topology: two binaries, global core ids, IPC regions.
' Source of truth: rticx.toml (see docs/user-guide.md §3).
' Render: plantuml -tsvg 01-project-topology.puml

title Project topology (rticx.toml)

skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName monospace
skinparam nodesep 15
skinparam ranksep 25
left to right direction

rectangle "app-m7 (binary)\ncore 0 — global id 0" as m7
rectangle "IPC region 0->1\nbase_from_source = 0x30040000\nbase_from_target = 0x30040000\nsize = 4096" as r01
rectangle "app-m4 (binary)\ncore 1 — global id 1" as m4
rectangle "IPC region 1->0\nbase_from_source = 0x30041000\nbase_from_target = 0x30041000\nsize = 4096" as r10

m7 --> r01 : "enqueue\n(per-task FIFO)"
r01 --> m4 : "drain\n(line dispatcher)"
m4 --> r10 : "enqueue\n(per-task FIFO)"
r10 --> m7 : "drain\n(line dispatcher)"

note bottom of r01
  One region per ordered core pair; sync allocates one
  per-task FIFO inside it. Doorbells are per (source -> target)
  pair: the generated ring function publishes the task id and
  triggers the pair router IRQ the distribution names (M6.5).
  Dispatcher lines come from the application's ipc_dispatchers
  pool, not from rticx.toml.
end note

@enduml
