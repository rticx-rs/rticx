@startuml 03-spawn-timeline
' Diagram 3 — Spawn flow A->B: producer, FIFO, ring function, doorbell router,
' ready queue, line dispatcher, exec (M6.5).
' Source of truth: docs/architecture.md §4 §7, plan §8.

title spawn flow A -> B (M6.5)

skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName monospace

participant "producer task\n(core A)" as P
participant "task FIFO\n(region A->B)" as F
participant "ring fn\n__rticx_xbin_ring_A_B" as R
participant "pair doorbell word\n+ IRQ" as D
participant "router ISR\n(core B, pair priority)" as RT
participant "ready queue\n(line)" as Q
participant "line dispatcher\n(core B, line priority)" as DS
participant "receiver exec" as X

P -> P : global-core guard,\ninterrupt-free
P -> F : enqueue(input)
P -> R : task_id
R -> D : publish id,\ntrigger router IRQ
D --> RT : router IRQ
RT -> D : read id (loop until empty)
RT -> Q : enqueue task id
RT -> DS : __rticx_local_irq_pend(line IRQ)
DS -> Q : pop ready entry
DS -> F : dequeue until empty
F -> X : input
DS -> X : exec(input)

note over D, DS
  unknown ids are ignored;
  duplicate and coalesced notifications
  lose no spawn because the dispatcher
  drains the FIFO until empty
end note

@enduml
