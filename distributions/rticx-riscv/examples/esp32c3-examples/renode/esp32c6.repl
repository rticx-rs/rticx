sysbus:
    init:
        Tag <0x20000 0x1c0000> "slot0_partition"
        Tag <0x1e0000 0x1c0000> "slot1_partition"
        Tag <0x3b0000 0x30000> "storage_partition"
        Tag <0x3e0000 0x1f000> "scratch_partition"
        Tag <0x0 0x10000> "boot_partition"
        Tag <0x10000 0x10000> "sys_partition"
        Tag <0x3a0000 0x8000> "slot0_lpcore_partition"
        Tag <0x3a8000 0x8000> "slot1_lpcore_partition"
        Tag <0x3ff000 0x1000> "coredump_partition"
        Tag <0x60001000 0x1000> "uart1"
        Tag <0x60002000 0x1000> "flash"
        Tag <0x60004000 0x1000> "i2c0"
        Tag <0x60007000 0x1000> "ledc0"
        Tag <0x60008000 0x1000> "timer0 / wdt0"
        Tag <0x60009000 0x1000> "timer1 / wdt1"
        Tag <0x6000a000 0x1000> "systimer0"
        Tag <0x6000b000 0x1000> "twai0"
        Tag <0x6000c000 0x1000> "i2s"
        Tag <0x6000d000 0x1000> "twai1"
        Tag <0x6000f000 0x1000> "usb_serial"
        Tag <0x60010000 0x1000> "intc"
        Tag <0x60012000 0x1000> "pcnt"
        Tag <0x60014000 0x1000> "mcpwm0"
        Tag <0x60080000 0x1000> "dma"
        Tag <0x60081000 0x1000> "spi2"
        Tag <0x60088000 0x1000> "aes"
        Tag <0x60091000 0x1000> "gpio0"
        Tag <0x600b1400 0x1000> "lp_uart"
        Tag <0x600b0c00 0x400> "rtc_timer"
        Tag <0x60089000 0x100> "sha"
        Tag <0x50003ff8 0x8> "mbox0"
        Tag <0x6000e000 0x4> "adc0"
        Tag <0x6000e058 0x4> "coretemp"
        Tag <0x600b2808 0x4> "trng0"

flash0: Memory.MappedMemory @ sysbus 0x0
    size: 0x800000

socrom: Memory.MappedMemory @ sysbus 0x40000000
    size: 0x50000

sramhp: Memory.MappedMemory @ sysbus 0x40800000
    size: 0x80000

ulpram_sramlp_ulpshm_lprtc_retainedmem_ipcshm: Memory.MappedMemory @ sysbus 0x50000000
    size: 0x4000

// autogenerated

cpu0: CPU.RiscV32 @ sysbus
    cpuType: "rv32imac_zicsr_zifencei"
    timeProvider: empty
    hartId: 0
    privilegedArchitecture: PrivilegedArchitecture.Priv1_10

uart0: UART.ESP32_UART @ sysbus 0x60000000