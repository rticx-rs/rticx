{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run QEMU with GDB",
      "type": "shell",
      "command": "./run.sh",
      "args": ["${workspaceFolder}/target/riscv32imc-unknown-none-elf/debug/examples/hello_rtic", "debug"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*"
        }
      }
    },
    {
      "label": "Run Hello RTIC in QEMU",
      "type": "shell",
      "command": "cargo build --examples hello_rtic && ./run.sh",
      "args": ["${workspaceFolder}/target/riscv32imc-unknown-none-elf/debug/examples/hello_rtic"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*"
        }
      }
    }
  ]
}